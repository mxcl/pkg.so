{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bundle_identifier": {
            "anyOf": [
              {
                "minLength": 5,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "sources": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "token": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token",
          "bundle_identifier",
          "confidence",
          "sources",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "results"
  ],
  "type": "object"
}
