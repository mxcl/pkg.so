{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "category-confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "type": "string"
          },
          "category_path": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "category_sources": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "config-file-location": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "linux": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "macos": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "unix": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "windows": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "type": "object"
              }
            ]
          },
          "credentials-file-location": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "linux": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "macos": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "unix": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "windows": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "type": "object"
              }
            ]
          },
          "display-name": {
            "minLength": 1,
            "type": "string"
          },
          "display-name-confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "type": "string"
          },
          "display_name_sources": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "docs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "docs-confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "type": "string"
          },
          "docs_sources": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "history": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "adoption-history": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "package-nerd-significance": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "project-history": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "related-projects": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "sources": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "summary": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "timeline": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "usage": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "adoption-history",
                  "package-nerd-significance",
                  "project-history",
                  "related-projects",
                  "sources",
                  "summary",
                  "timeline",
                  "usage"
                ],
                "type": "object"
              }
            ]
          },
          "history-confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "type": "string"
          },
          "history_sources": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "repo": {
            "type": [
              "string",
              "null"
            ]
          },
          "repo-confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "type": "string"
          },
          "repo_sources": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "tags-confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "type": "string"
          },
          "tags_sources": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "related-packages": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(brew|cask|npm|pip|cargo):[^\\s:]+$"
                },
                "rel": {
                  "type": "string",
                  "enum": [
                    "alternative",
                    "adjacent_workflow"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^https?://[^/\\s]+"
                  }
                }
              },
              "required": [
                "id",
                "rel",
                "reason",
                "sources"
              ]
            }
          }
        },
        "required": [
          "id",
          "repo",
          "repo-confidence",
          "display-name",
          "display-name-confidence",
          "category_path",
          "category-confidence",
          "docs",
          "docs-confidence",
          "config-file-location",
          "credentials-file-location",
          "history",
          "history-confidence",
          "tags",
          "tags-confidence",
          "repo_sources",
          "docs_sources",
          "category_sources",
          "tags_sources",
          "display_name_sources",
          "history_sources",
          "related-packages"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "results"
  ],
  "type": "object"
}
